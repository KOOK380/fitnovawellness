# ── Vercel → Project → Settings → Environment Variables ──────────
# Your live domain — canonical URLs, sitemap, Open Graph, schema.org
NEXT_PUBLIC_SITE_URL=https://fitnovawellness.com
# The Laravel API + admin on Hostinger (no trailing slash)
CMS_API_URL=https://api.fitnovawellness.com
# Long random string; must be the same as REVALIDATE_SECRET in the Laravel .env
REVALIDATE_SECRET=change-me-to-a-long-random-string
